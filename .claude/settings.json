{
  "permissions": {
    "allow": [
      "Read(*)",
      "Bash(ls *)"
    ],
    "ask": [
      "Edit(*)",
      "Write(*)",
      "Bash(rm *)"
    ],
    "deny": [
      "Bash(git *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)"
    ]
  }
}
