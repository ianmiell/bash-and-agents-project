{
  "permissions": {
    "allow": [
      "Read(*)",
      "Bash(ls *)"
    ],
    "ask": [
      "Edit(*)",
      "Write(*)",
      "Bash(rm *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/log-bash/log-bash-commands.sh"
          }
        ]
      }
    ]
  }
}
